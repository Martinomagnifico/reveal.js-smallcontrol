extends templates/layouts/_reveal.pug

append variables
	- presentation.title = presentation.title

block slides
	include slides/_slides

block beforeslides
	+badge(plugin.name.toLowerCase())

block append scripts
	+revealsrc("script", "dist/plugin/highlight.js")

	if process.env.NODE_ENV === 'production'
		script(src=`plugin/${plugin.name}/${plugin.name}.js`)
		script.
			Reveal.initialize({
				transition: "slide",
				hash: true,
				smallcontrol: {
					autoscale: true
				},
				plugins: [ Smallcontrol, RevealHighlight ]
			});
	else
		script(type="module").
			import Smallcontrol from '@/plugin/js/index';
			Reveal.initialize({
				transition: "slide",
				hash: true,
				smallcontrol: {
					autoscale: true,
					debug: true
				},
				plugins: [ Smallcontrol, RevealHighlight ]
			});
