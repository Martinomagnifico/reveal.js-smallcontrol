{
	"name": "reveal.js-smallcontrol",
	"version": "1.1.0",
	"description": "A plugin for Reveal.js that makes the vertical controls significantly smaller",
	"keywords": [
		"reveal",
		"reveal.js",
		"reveal-plugin",
		"plugin",
		"controls",
		"arrows"
	],
	"homepage": "https://github.com/martinomagnifico/reveal.js-smallcontrol",
	"license": "MIT",
	"author": {
		"name": "Martijn De Jongh (Martino)",
		"email": "martijn.de.jongh@gmail.com",
		"web": "https://martinomagnifico.github.io",
		"url": "https://martinomagnifico.github.io",
		"username": "martinomagnifico"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/martinomagnifico/reveal.js-smallcontrol.git"
	},
	"type": "module",
	"main": "./plugin/smallcontrol/smallcontrol.js",
	"module": "./plugin/smallcontrol/smallcontrol.mjs",
	"exports": {
		".": {
			"import": "./plugin/smallcontrol/smallcontrol.mjs",
			"require": "./plugin/smallcontrol/smallcontrol.js"
		},
		"./plugin/*": "./plugin/*",
		"./smallcontrol.css": "./plugin/smallcontrol/smallcontrol.css",
		"./package.json": "./package.json"
	},
	"style": "./plugin/smallcontrol/smallcontrol.css",
	"files": [
		"plugin/smallcontrol",
		"CHANGELOG.md"
	],
	"scripts": {
		"start": "npm run dev",
		"copy-reveal": "node scripts/copy-reveal.mjs",
		"copy-plugin": "node scripts/copy-plugin.mjs",
		"copy-simplemenu": "node scripts/copy-simplemenu.mjs",
		"dev": "vite",
		"prebuild": "rimraf demo plugin",
		"build-plugin": "vite build -c vite.lib.config.ts",
		"build-demo": "vite build -c vite.config.ts",
		"build": "npm run build-plugin && npm run build-demo && npm run copy-reveal && npm run copy-plugin && npm run copy-simplemenu",
		"prepublishOnly": "npm run build",
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check": "biome check --write .",
		"preview": "npm run build && vite preview",
		"ci": "biome ci ."
	},
	"peerDependencies": {
		"reveal.js": ">=4.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.10",
		"@types/node": "^26.2.0",
		"@types/reveal.js": "^5.2.2",
		"@vituum/vite-plugin-pug": "^2.0.1",
		"fs-extra": "^11.4.0",
		"reveal.js-plugintoolkit": "^1.2.6",
		"reveal.js-simplemenu": "^2.2.0",
		"rimraf": "^6.1.3",
		"sass": "^1.103.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vituum": "^2.0.2"
	}
}
